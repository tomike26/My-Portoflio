# Contact form delivery (https://resend.com). Without RESEND_API_KEY the form
# tells visitors it's unavailable and points them to email instead.
RESEND_API_KEY=
# Optional. Defaults to kolajoelizabeth@gmail.com
CONTACT_TO_EMAIL=
# Optional. Must be a sender on a domain verified in Resend.
# Defaults to Resend's test sender, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
